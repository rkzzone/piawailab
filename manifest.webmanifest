{
  "name": "PiawaiLab — Alat PDF, dokumen & media",
  "short_name": "PiawaiLab",
  "description": "Merge, compress, convert, tanda tangan & watermark tak terlihat — semua diproses di perangkat Anda.",
  "lang": "id",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fafafc",
  "theme_color": "#6a4cff",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Merge PDF", "url": "./#/merge" },
    { "name": "Compress", "url": "./#/compress" },
    { "name": "Watermark", "url": "./#/watermark" },
    { "name": "Tanda tangan PDF", "url": "./#/sign" }
  ],
  "file_handlers": [
    { "action": "./#/merge", "accept": { "application/pdf": [".pdf"] } }
  ]
}
